    m_Localized: "\uC9C4\uD589 \uC911\uC778 \uD0D0\uD5D8\uC744 \uD3EC\uAE30\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\\n\uC9C0\uAE08\uAE4C\uC9C0
      \uC313\uC778 \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uC758 20%\uB9CC \uD68D\uB4DD\uD569\uB2C8\uB2E4."
