  - m_Id: 40210342097059842
    m_Localized: "\uC804\uC6A9 \uC77C\uC77C \uBCF4\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 40229268445069312
    m_Localized: "(\uB9CC\uB8CC)"
    m_Metadata:
      m_Items: []
  - m_Id: 42163135020138496
    m_Localized: "\uD301: \uD0D0\uC0AC \uC9C0\uC5ED\uC744 \uD074\uB9AC\uC5B4\uD558\uBA74
      \uC0C8 \uC9C0\uC5ED\uC774 \uAC1C\uBC29\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 42163135078858752
    m_Localized: "\uD301: \uD568\uC120 \uBAA8\uB4C8\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uBA74
      \uD568\uB300 \uC804\uD22C\uB825\uC774 \uD5A5\uC0C1\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 42163135078858753
    m_Localized: "\uD301: \uD0D0\uC0AC\uB97C \uD1B5\uD574 \uACBD\uD5D8\uCE58\uB97C
      \uC313\uC544 \uC9C0\uD718 \uB808\uBCA8\uC744 \uC62C\uB9AC\uACE0 \uC0C8 \uBAA8\uB4C8\uC744
      \uAC1C\uBC29\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42163135078858754
    m_Localized: "\uD301: \uB2E4\uC591\uD55C \uD568\uC120\uC744 \uBC30\uCE58\uD558\uBA74
      \uD568\uB300 \uC2DC\uB108\uC9C0\uAC00 \uB192\uC544\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 42163135078858755
    m_Localized: "\uD301: \uC790\uC6D0\uC774 \uBD80\uC871\uD560 \uB54C\uB294 \uD0D0\uC0AC\uB97C
      \uBA3C\uC800 \uC9C4\uD589\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 43649151266586624
    m_Localized: "PvP \uC804\uD22C\uC5D0\uC11C \uD1F4\uAC01\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
