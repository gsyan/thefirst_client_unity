  - m_Id: 74139633343922176
    m_Localized: "\uC9C4\uD589 \uC911\uC778 \uB2E4\uB978 \uD0D0\uD5D8\uC774 \uC788\uC2B5\uB2C8\uB2E4.\\n\uC874
      {0} / \uAD6C\uC5ED {1} / \uC801\uB9BD\uB41C \uD0D0\uD5D8 \uD3EC\uC778\uD2B8
      {2}\\n\uD3EC\uAE30\uD558\uACE0 \uC120\uD0DD\uD55C \uC874\uC5D0 \uC0C8\uB85C
      \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\\n* \uD3EC\uAE30 \uC2DC \uC801\uB9BD\uB41C
      \uD3EC\uC778\uD2B8\uC758 50%\uB9CC \uD68C\uC218 \uAC00\uB2A5\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 74139633398448128
    m_Localized: "\uB2E4\uB978 \uC874\uC5D0 \uC9C4\uD589 \uC911\uC778 \uD0D0\uD5D8\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08 \uD3EC\uAE30\uD558\uBA74 \uC313\uC778
      \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uC758 50%\uB9CC \uD68D\uB4DD\uD569\uB2C8\uB2E4.
      \uD3EC\uAE30\uD558\uACE0 \uC0C8\uB85C \uB3C4\uC804\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 74139633398448129
    m_Localized: "\uC9C4\uD589 \uC911\uC778 \uD0D0\uD5D8\uC744 \uD3EC\uAE30\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?
