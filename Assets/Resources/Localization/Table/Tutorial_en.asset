MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 0ded921c495564e4396ea127f3f166c8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 267705026215936
    m_Localized: The Siegfried Fleet needs a new ship right now. Please follow my
      instructions and proceed.
    m_Metadata:
      m_Items: []
  - m_Id: 263406917386240
    m_Localized: 'Hello again, Commander. This is your training AI.

      Let''s
      continue today''s training to become a fleet commander.'
    m_Metadata:
      m_Items: []
  - m_Id: 267705026215937
    m_Localized: Open the Fleet tab.
    m_Metadata:
      m_Items: []
  - m_Id: 267705026215938
    m_Localized: Press the Add Ship button.
    m_Metadata:
      m_Items: []
  - m_Id: 1319437449691136
    m_Localized: Adding a ship requires a certain Commander Level, and you currently
      meet it.
    m_Metadata:
      m_Items: []
  - m_Id: 1319437483245568
    m_Localized: Adding a ship consumes Module Points, but they can be recovered
      anytime, so don't worry.
    m_Metadata:
      m_Items: []
  - m_Id: 1319437483245569
    m_Localized: Please confirm adding the ship.
    m_Metadata:
      m_Items: []
  - m_Id: 1328699047542784
    m_Localized: Please lead this ship and fleet well, so you can reach the farthest
      ends of space, beyond the enemy's reach.
    m_Metadata:
      m_Items: []
  - m_Id: 1336507092566016
    m_Localized: The new ship has been added.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444003811328
    m_Localized: The new ship has been added. Touch the ship.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444041560064
    m_Localized: Touch the Ship Management button.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444049948672
    m_Localized: Select the Beam module.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444054142976
    m_Localized: Upgrade the Beam module. You still have enough Module Points.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444058337280
    m_Localized: Select the Missile module.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444062531584
    m_Localized: Unlock the Missile module. You still have enough Module Points.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444066725888
    m_Localized: Upgrade the Missile module. You still have enough Module Points.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444075114496
    m_Localized: Select the Hangar module.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444079308800
    m_Localized: Unlock the Hangar module. You still have enough Module Points.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444083503104
    m_Localized: Upgrade the Hangar module. You still have enough Module Points.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444087697408
    m_Localized: Select the Hull module.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444091891712
    m_Localized: Upgrade the Hull module. You still have enough Module Points.
    m_Metadata:
      m_Items: []
  - m_Id: 1368444096086016
    m_Localized: Upgrading the Hull module increases not only the ship's HP but also
      the number of attack modules.
    m_Metadata:
      m_Items: []
  - m_Id: 1380098930245632
    m_Localized: This concludes the ship management training.
    m_Metadata:
      m_Items: []
  - m_Id: 1380098980577280
    m_Localized: Emergency! Multiple enemy fleets approaching!!
    m_Metadata:
      m_Items: []
  - m_Id: 1380098984771584
    m_Localized: The enemy fleet is warping in.
    m_Metadata:
      m_Items: []
  - m_Id: 1380098988965888
    m_Localized: Is it fortunate or unfortunate to experience a fleet battle?
    m_Metadata:
      m_Items: []
  - m_Id: 1380098993160192
    m_Localized: A massive enemy fleet is warping in.
    m_Metadata:
      m_Items: []
  - m_Id: 1380098997354496
    m_Localized: The battle situation is very unfavorable. All personnel except essential
      combat commanders must board the escape ship immediately.
    m_Metadata:
      m_Items: []
  - m_Id: 1380099001548800
    m_Localized: Evacuating immediately.
    m_Metadata:
      m_Items: []
  - m_Id: 1380099005743104
    m_Localized: You are now the commander of this ship.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
