MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 0ded921c495564e4396ea127f3f166c8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 267705026215936
    m_Localized: The Siegfried Fleet needs a new ship right now. Please follow my
      instructions and proceed.
    m_Metadata:
      m_Items: []
  - m_Id: 263406917386240
    m_Localized: 'Hello again, Commander. This is your training AI.

      Let''s
      continue today''s training to become a fleet commander.'
    m_Metadata:
      m_Items: []
  - m_Id: 1319437449691136
    m_Localized: Select the hull for the ship you want to add.
    m_Metadata:
      m_Items: []
  - m_Id: 1319437483245568
    m_Localized: Placing a hull requires allocating a certain amount of Command Power.
      Please choose one that doesn't exceed your Command Power limit.
    m_Metadata:
      m_Items: []
  - m_Id: 1319437483245569
    m_Localized: Press Confirm to finalize your selection.
    m_Metadata:
      m_Items: []
  - m_Id: 1328699047542784
    m_Localized: Please lead this ship and fleet well, so you can reach the farthest
      ends of space, beyond the enemy's reach.
    m_Metadata:
      m_Items: []
  - m_Id: 1336507092566016
    m_Localized: The new ship has been added.
    m_Metadata:
      m_Items: []
  - m_Id: 1380098930245632
    m_Localized: This concludes the ship management training.
    m_Metadata:
      m_Items: []
  - m_Id: 1380098980577280
    m_Localized: Emergency! Multiple enemy fleets approaching!!
    m_Metadata:
      m_Items: []
  - m_Id: 1380098984771584
    m_Localized: The enemy fleet is warping in.
    m_Metadata:
      m_Items: []
  - m_Id: 1380098988965888
    m_Localized: "All enemy fleets have been dealt with. We gained some combat experience
      against weak enemies \u2014 is that a stroke of luck?"
    m_Metadata:
      m_Items: []
  - m_Id: 1380098993160192
    m_Localized: A massive enemy fleet is warping in.
    m_Metadata:
      m_Items: []
  - m_Id: 1380098997354496
    m_Localized: The battle situation is very unfavorable. All personnel except essential
      combat commanders must board the escape ship immediately.
    m_Metadata:
      m_Items: []
  - m_Id: 1380099001548800
    m_Localized: Evacuating immediately.
    m_Metadata:
      m_Items: []
  - m_Id: 1380099005743104
    m_Localized: You are now the commander of this ship.
    m_Metadata:
      m_Items: []
  - m_Id: 1726800145022976
    m_Localized: Module Points alone won't be enough to overcome the enemies ahead.
    m_Metadata:
      m_Items: []
  - m_Id: 1726800233103360
    m_Localized: You can now upgrade modules with Mineral too. Try switching to Mineral
      upgrade mode.
    m_Metadata:
      m_Items: []
  - m_Id: 1726800233103361
    m_Localized: The total amount of Mineral used for upgrades is shown next to your
      Mineral balance.
    m_Metadata:
      m_Items: []
  - m_Id: 1726800233103362
    m_Localized: Mineral used for upgrades can be reclaimed anytime, but is permanently
      deducted once you win the battle.
    m_Metadata:
      m_Items: []
  - m_Id: 5392725658435584
    m_Localized: To grow your fleet and withstand the enemies in pursuit, you need
      to explore to gain resources and strengthen your fleet. Try tapping the Exploration
      button.
    m_Metadata:
      m_Items: []
  - m_Id: 5392725700378625
    m_Localized: Move your fleet to an adjacent cell on the grid.
    m_Metadata:
      m_Items: []
  - m_Id: 5392725700378626
    m_Localized: Confirm the move command.
    m_Metadata:
      m_Items: []
  - m_Id: 26288532360134656
    m_Localized: Open the Fleet Manage Panel.
    m_Metadata:
      m_Items: []
  - m_Id: 26434500229464064
    m_Localized: Press the Deploy Ship button.
    m_Metadata:
      m_Items: []
  - m_Id: 26469773436911616
    m_Localized: The new ship has been added. Select it.
    m_Metadata:
      m_Items: []
  - m_Id: 26469773495631872
    m_Localized: Press the Edit Ship button to edit its modules.
    m_Metadata:
      m_Items: []
  - m_Id: 26469773495631873
    m_Localized: Try installing the Beam module.
    m_Metadata:
      m_Items: []
  - m_Id: 26469773495631874
    m_Localized: Press Confirm to apply the changes.
    m_Metadata:
      m_Items: []
  - m_Id: 26653119160909825
    m_Localized: Press the Start Battle button to engage the enemy fleet.
    m_Metadata:
      m_Items: []
  - m_Id: 26653119160909826
    m_Localized: Victory! The resources gained have been added to your Banked total.
    m_Metadata:
      m_Items: []
  - m_Id: 26653119160909827
    m_Localized: Keep moving through the grid to find the cell where you can escape
      this zone.
    m_Metadata:
      m_Items: []
  - m_Id: 26655375268642816
    m_Localized: "This shows your Exploration Points \u2014 the top number is your
      confirmed Owned total, and the bottom number is the Banked amount you're accumulating
      this run (not yet confirmed)."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950338236416
    m_Localized: Let's check your Fleet. Open the fleet management screen.
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762368
    m_Localized: Command Power lets you deploy more or stronger ships. Tap here to
      increase it.
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762369
    m_Localized: Select the All button to use all your Exploration Points.
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762370
    m_Localized: Press Confirm to convert your Exploration Points into Command Power.
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762371
    m_Localized: Command Power increased! Come back anytime you have spare Exploration
      Points.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
