  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 0ded921c495564e4396ea127f3f166c8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5392725700378625
    m_Localized: "\uBC1D\uAC8C \uBE5B\uB098\uB294 \uC140\uC744 \uB20C\uB7EC \uD568\uB300\uB97C
      \uC774\uB3D9\uC2DC\uD0A4\uACE0, \uC801\uACFC \uC804\uD22C\uB97C \uC2DC\uC791\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5392725700378626
    m_Localized: "\uC774\uB3D9 \uBA85\uB839\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26653119160909825
    m_Localized: "\uC804\uD22C \uC2DC\uC791 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC801
      \uD568\uB300\uC640 \uAD50\uC804\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26653119160909827
    m_Localized: "\uACC4\uC18D \uC774\uB3D9\uD558\uBA70 \uC774 \uC874\uC744 \uD0C8\uCD9C\uD560
      \uC218 \uC788\uB294 \uC9C0\uC5ED\uC744 \uCC3E\uC544\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950338236416
    m_Localized: "\uD568\uB300\uB97C \uD655\uC778\uD574\uBD05\uC2DC\uB2E4. \uD568\uB300
      \uAD00\uB9AC \uD654\uBA74\uC744 \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762368
    m_Localized: "\uC9C0\uD718\uB825\uC774 \uB298\uC5B4\uB098\uBA74 \uB354 \uB9CE\uAC70\uB098
      \uAC15\uD55C \uD568\uC120\uC744 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC5EC\uAE30\uB97C \uB20C\uB7EC \uC9C0\uD718\uB825\uC744 \uB298\uB824\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762369
    m_Localized: "\uC804\uCCB4 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBCF4\uC720\uD55C
      \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uB97C \uBAA8\uB450 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762370
    m_Localized: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uB97C
      \uC9C0\uD718\uB825\uC73C\uB85C \uC804\uD658\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762371
    m_Localized: "\uC9C0\uD718\uB825\uC774 \uC99D\uAC00\uD588\uC2B5\uB2C8\uB2E4!
      \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uAC00 \uB0A8\uC744 \uB54C\uB9C8\uB2E4 \uC5B8\uC81C\uB4E0
      \uB2E4\uC2DC \uCC3E\uC544\uC640 \uC804\uD658\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340544
    m_Localized: "\uC5EC\uAE30\uB97C \uB20C\uB7EC \uD568\uCCB4 \uC120\uD0DD \uBAA9\uB85D\uC744
      \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340545
    m_Localized: "\uC7A0\uAE34 \uD568\uCCB4\uB294 \uC5C5\uC801 \uD3EC\uC778\uD2B8\uB85C
      \uC5B8\uB77D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC7A0\uAE34 \uD568\uCCB4\uC758
      \uC5B8\uB77D \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC0AC\uC6A9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340546
    m_Localized: "\uC9C0\uD718\uAD00 \uB808\uBCA8\uC774 \uC62C\uB77C \uD568\uC120\uC744
      \uD55C \uCC99 \uB354 \uBC30\uCE58\uD560 \uC218 \uC788\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4!
      \uD568\uB300 \uAD00\uB9AC \uD654\uBA74\uC744 \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340547
    m_Localized: "\uC0C8\uB85C \uC5F4\uB9B0 \uBE48 \uC2AC\uB86F\uC744 \uB20C\uB7EC
      \uD568\uC120\uC744 \uCD94\uAC00\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340548
    m_Localized: "\uBC30\uCE58\uD560 \uD568\uCCB4\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340549
    m_Localized: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD568\uC120\uC744
      \uBC30\uCE58\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340550
    m_Localized: "\uD568\uC120\uC774 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4!
      \uC9C0\uD718\uAD00 \uB808\uBCA8\uC774 \uC624\uB97C\uC218\uB85D \uB354 \uB9CE\uC740
      \uD568\uC120\uC744 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28414612789395456
    m_Localized: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC5C5\uC801 \uD3EC\uC778\uD2B8\uB97C
      \uC0AC\uC6A9\uD574 \uD568\uCCB4\uB97C \uC5B8\uB77D\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28430607918694400
    m_Localized: "\uC9C0\uD718\uB825\uC774 \uBD80\uC871\uD574 \uC774 \uD568\uC120\uC744
      \uBC30\uCE58\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uB97C
      \uC9C0\uD718\uB825\uC73C\uB85C \uC804\uD658\uD574 \uC9C0\uD718\uB825\uC744
      \uD655\uBCF4\uD55C \uB4A4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48467487145984000
    m_Localized: "\uD568\uB300\uC5D0 \uD568\uC120\uC744 9\uCC99 \uBC30\uCE58\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48467487208898560
    m_Localized: "\uD568\uC120 \uBC30\uCE58\uC5D0\uB294 \uC9C0\uD718\uB825\uC774
      \uD544\uC694\uD569\uB2C8\uB2E4. \uC9C0\uD718\uB825\uC740 \uC9C0\uD718\uAD00\uC758
      \uB808\uBCA8\uC774 \uC624\uB984\uC5D0 \uB530\uB77C \uAC19\uC774 \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535926165504
    m_Localized: "\uD568\uC120\uC744 \uBC14\uAFB8\uB824\uBA74 \uBA3C\uC800 \uBC30\uCE58\uB41C
      \uD568\uC120\uC744 \uD574\uC81C\uD574\uC57C \uD569\uB2C8\uB2E4. \uBC30\uCE58\uD574\uC81C
      \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080064
    m_Localized: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC774 \uC2AC\uB86F\uC758
      \uD568\uC120\uC744 \uBC30\uCE58 \uD574\uC81C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080065
    m_Localized: "\uBE44\uC5B4 \uC788\uB294 \uC2AC\uB86F\uC744 \uB20C\uB7EC \uD568\uCCB4
      \uC120\uD0DD \uBAA9\uB85D\uC744 \uB2E4\uC2DC \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080066
    m_Localized: "\uBC29\uAE08 \uC5B8\uB77D\uD55C \uD568\uCCB4\uAC00 \uC120\uD0DD\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBC30\uCE58 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBC30\uCE58\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080067
    m_Localized: "\uC0C8 \uD568\uC120\uC774 \uBC30\uCE58\uB418\uC5C8\uC2B5\uB2C8\uB2E4!
      \uC5C5\uC801 \uD3EC\uC778\uD2B8\uB97C \uBAA8\uC544 \uB354 \uAC15\uB825\uD55C
      \uD568\uCCB4\uB97C \uC5B8\uB77D\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080068
    m_Localized: "\uC5C5\uC801 \uD3EC\uC778\uD2B8\uAC00 \uC313\uC5EC \uBAA8\uB4C8\uC744
      \uAC15\uD654\uD560 \uC218 \uC788\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4! \uC774
      \uD568\uC120\uC758 \uAD00\uB9AC \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080069
    m_Localized: "\uC774 \uD56D\uBAA9\uC758 \uAD00\uB9AC \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uAC15\uD654 \uD654\uBA74\uC744 \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080070
    m_Localized: "\uAC15\uD654 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC5C5\uC801 \uD3EC\uC778\uD2B8\uB85C
      \uB808\uBCA8\uC744 \uC62C\uB824\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080071
    m_Localized: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC5C5\uC801 \uD3EC\uC778\uD2B8\uB97C
      \uC0AC\uC6A9\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080072
    m_Localized: "\uAC15\uD654\uB418\uC5C8\uC2B5\uB2C8\uB2E4! \uC0C8 \uB808\uBCA8\uC740
      \uBC14\uB85C \uC801\uC6A9\uB429\uB2C8\uB2E4. \uB2EB\uAE30 \uBC84\uD2BC\uC744
      \uB204\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080073
    m_Localized: "\uAC15\uD654\uB294 \uAC19\uC740 \uC885\uB958\uC758 \uD568\uCCB4\uC5D0
      \uC601\uAD6C\uC801\uC73C\uB85C \uC801\uC6A9\uB429\uB2C8\uB2E4. \uC5C5\uC801
      \uD3EC\uC778\uD2B8\uB97C \uBAA8\uC544 \uD568\uC120\uC744 \uB354 \uAC15\uD558\uAC8C
      \uB9CC\uB4E4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080074
    m_Localized: "\uC804\uD22C\uD560 \uC218 \uC788\uB294 PVP \uC0C1\uB300 \uCE74\uB4DC
      \uBAA9\uB85D\uC785\uB2C8\uB2E4. \uD55C \uBA85\uC744 \uACE8\uB77C \uC804\uD22C\uD558\uACE0,
      \uC774\uAE30\uBA74 \uC810\uC218\uAC00 \uC624\uB985\uB2C8\uB2E4. \uC804\uD22C\uD558\uB824\uBA74
      \uC77C\uC815 \uC9C0\uD718\uAD00 \uB808\uBCA8\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080075
    m_Localized: "\uB0B4 \uC810\uC218\uC640 \uC21C\uC704, \uD604\uC7AC \uC2DC\uC98C
      \uC815\uBCF4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080076
    m_Localized: "\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uC0C1\uB300\uAC00 \uC5C6\uC73C\uBA74
      \uBAA9\uB85D\uC744 \uAC31\uC2E0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC31\uC2E0\uC740
      \uD558\uB8E8 \uD69F\uC218\uAC00 \uC815\uD574\uC838 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080077
    m_Localized: "\uC21C\uC704\uD45C \uD0ED\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48491535989080078
    m_Localized: "PVP \uC21C\uC704\uC640 \uD0D0\uC0AC \uC874 \uC21C\uC704\uB97C \uC804\uD658\uD558\uBA70
      \uB2E4\uB978 \uC9C0\uD718\uAD00\uB4E4\uC758 \uC21C\uC704\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48492889763610627
    m_Localized: "\uC9C4\uD589 \uC911\uC778 \uD0D0\uD5D8\uC740 \uC5EC\uAE30\uC11C
      \uD3EC\uAE30\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD3EC\uAE30\uD558\uBA74
      \uC9C0\uD718\uAD00 \uACBD\uD5D8\uCE58\uB97C \uBC1B\uC744 \uC218 \uC5C6\uACE0,
      \uB0A8\uC740 \uAD11\uBB3C\uB3C4 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48492889767804928
    m_Localized: "\uD0C8\uCD9C \uC9C0\uC810\uC744 \uCC3E\uC544 \uC874\uC744 \uD0C8\uCD9C\uD558\uBA74
      \uBCF4\uC0C1\uC744 \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48492889767804929
    m_Localized: "\uBE54, \uBBF8\uC0AC\uC77C, \uD568\uC7AC\uAE30, \uC218\uB9AC, \uC2E4\uB4DC,
      \uC694\uACA9\uCCB4 \uC804\uC220\uC744 \uCF1C\uACE0 \uB04C \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uCF1C \uB454 \uC804\uC220\uC740 \uC804\uD22C \uC911 \uC790\uC6D0\uC744 \uC18C\uBAA8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48501020866510848
    m_Localized: "\uC774\uBC88 \uC804\uD22C\uC5D0\uC11C \uD68D\uB4DD\uD55C \uAD11\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48501020929425408
    m_Localized: "\uAD11\uBB3C\uC744 \uC0AC\uC6A9\uD574 \uBCF4\uC0C1 \uCE74\uB4DC\uB97C
      \uAD6C\uB9E4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCE74\uB4DC\uC758 \uD6A8\uACFC\uB294
      \uC774\uBC88 \uD0D0\uD5D8 \uB3D9\uC548 \uC720\uC9C0\uB418\uACE0, \uAC19\uC740
      \uD6A8\uACFC\uC758 \uCE74\uB4DC\uB97C \uB610 \uC0AC\uBA74 \uB204\uC801\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48501020929425409
    m_Localized: "\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uCE74\uB4DC\uAC00 \uC5C6\uC73C\uBA74
      \uB2E4\uC2DC \uBF51\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uBF51\uAE30\uB294
      \uD69F\uC218\uAC00 \uC81C\uD55C\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48501020929425410
    m_Localized: "\uAD6C\uB9E4\uB97C \uB9C8\uCCE4\uB2E4\uBA74 \uB2EB\uAE30 \uBC84\uD2BC\uC744
      \uB20C\uB7EC \uACC4\uC18D \uC9C4\uD589\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 48502460200648704
    m_Localized: "\uCE74\uB4DC \uAD6C\uB9E4 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74
      \uC5B8\uC81C\uB4E0 \uAD11\uBB3C\uB85C \uBCF4\uC0C1 \uCE74\uB4DC\uB97C \uAD6C\uB9E4\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 48507305666150400
    m_Localized: "\uCE74\uB4DC \uAD6C\uB9E4 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uAD11\uBB3C\uB85C
      \uBCF4\uC0C1 \uCE74\uB4DC\uB97C \uAD6C\uB9E4\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
