--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 0ded921c495564e4396ea127f3f166c8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 267705026215936
    m_Localized: "\uC9C0\uD06C\uD504\uB9AC\uD2B8 \uD568\uB300\uB294 \uC9C0\uAE08
      \uC0C8\uB85C\uC6B4 \uD568\uC120\uC744 \uCD94\uAC00\uD574\uC57C \uD569\uB2C8\uB2E4.
      \uC81C \uC124\uBA85\uC5D0 \uB530\uB77C \uC9C4\uD589\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 263406917386240
    m_Localized: "\uC548\uB155\uD558\uC138\uC694, \uC9C0\uD718\uAD00\uB2D8. \uD6C8\uB828
      AI\uC785\uB2C8\uB2E4.\n\uC624\uB298\uB3C4 \uD568\uB300 \uC9C0\uD718\uAD00\uC774
      \uB418\uAE30 \uC704\uD55C \uD6C8\uB828\uC744 \uC774\uC5B4 \uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1319437449691136
    m_Localized: "\uCD94\uAC00\uD560 \uD568\uC120\uC758 \uD568\uCCB4\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1319437483245568
    m_Localized: "\uD568\uCCB4 \uBC30\uCE58\uC5D0\uB294 \uC77C\uC815 \uC9C0\uD718\uB825\uC744
      \uD560\uB2F9\uD574\uC57C \uD569\uB2C8\uB2E4. \uC9C0\uD718\uB825 \uD55C\uB3C4\uB97C
      \uB118\uC9C0 \uC54A\uAC8C \uC120\uD0DD\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1319437483245569
    m_Localized: "\uCD5C\uC885 \uC801\uC6A9\uC744 \uC704\uD574\uC11C\uB294 \uD655\uC778\uC744
      \uB204\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1328699047542784
    m_Localized: "\uC801\uB4E4\uC758 \uC190\uAE38\uC774 \uB2FF\uC9C0 \uC54A\uC744
      \uB9CC\uD07C \uBA40\uACE0 \uBA3C \uC6B0\uC8FC\uC758 \uB05D\uC5D0 \uB3C4\uB2EC\uD560
      \uC218 \uC788\uB3C4\uB85D \uC774 \uD568\uC120, \uD568\uB300\uB97C \uC798 \uC774\uB04C\uC5B4
      \uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1336507092566016
    m_Localized: "\uD568\uC120\uC774 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380098930245632
    m_Localized: "\uD568\uC120 \uAD00\uB9AC \uD6C8\uB828 \uACFC\uC815\uC740 \uC774\uB9CC
      \uB9C8\uCE58\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380098980577280
    m_Localized: "\uAE34\uAE09 \uC0C1\uD669, \uC801 \uD568\uB300 \uB2E4\uC218 \uC811\uADFC
      \uC911!!"
    m_Metadata:
      m_Items: []
  - m_Id: 1380098984771584
    m_Localized: "\uC801 \uD568\uB300\uAC00 \uC6CC\uD504\uC778\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380098988965888
    m_Localized: "\uC801 \uD568\uB300\uB97C \uBAA8\uB450 \uCC98\uB9AC\uD588\uC2B5\uB2C8\uB2E4.
      \uC57D\uD55C \uC801\uB4E4\uB85C \uC804\uD22C \uACBD\uD5D8\uC744 \uC313\uC558\uC73C\uB2C8,
      \uC6B4\uC774 \uC88B\uC740 \uAC78\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1380098993160192
    m_Localized: "\uC5C4\uCCAD\uB09C \uADDC\uBAA8\uC758 \uC801 \uD568\uB300\uAC00
      \uC6CC\uD504\uC778\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380098997354496
    m_Localized: "\uC804\uD669\uC774 \uB9E4\uC6B0 \uBD88\uB9AC\uD569\uB2C8\uB2E4.
      \uD544\uC218 \uC804\uD22C \uC9C0\uD718\uAD00\uC744 \uC81C\uC678\uD55C \uBAA8\uB4E0
      \uC790\uC6D0\uC740 \uC9C0\uAE08 \uC989\uC2DC \uD0C8\uCD9C \uD568\uC120\uC5D0
      \uD0D1\uC2B9 \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380099001548800
    m_Localized: "\uC9C0\uAE08 \uC989\uC2DC \uD0C8\uCD9C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380099005743104
    m_Localized: "\uB2F9\uC2E0\uC740 \uC774\uC81C \uC774 \uD568\uC120\uC758 \uC9C0\uD718\uAD00\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1726800145022976
    m_Localized: "\uC774\uC81C\uBD80\uD130\uB294 \uBAA8\uB4C8 \uD3EC\uC778\uD2B8\uB9CC\uC73C\uB85C\uB294
      \uC55E\uC73C\uB85C \uB9CC\uB0A0 \uC801\uB4E4\uC744 \uC774\uACA8\uB0B4\uAE30
      \uC5B4\uB824\uC6B8 \uAC83\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1726800233103360
    m_Localized: "\uC774\uC81C \uBBF8\uB124\uB784\uB85C\uB3C4 \uBAA8\uB4C8\uC744
      \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBBF8\uB124\uB784 \uAC15\uD654
      \uBAA8\uB4DC\uB85C \uBCC0\uACBD\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1726800233103361
    m_Localized: "\uBBF8\uB124\uB784 \uAC15\uD654\uC5D0 \uC0AC\uC6A9\uD55C \uBBF8\uB124\uB784\uC758
      \uCD1D\uB7C9\uC740 \uBCF4\uC720 \uBBF8\uB124\uB784 \uC606\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1726800233103362
    m_Localized: "\uBBF8\uB124\uB784 \uAC15\uD654\uC5D0 \uC0AC\uC6A9\uD55C \uBBF8\uB124\uB784\uC740
      \uC5B8\uC81C\uB4E0 \uD68C\uC218\uD560 \uC218 \uC788\uC9C0\uB9CC, \uC804\uD22C\uC5D0\uC11C
      \uC2B9\uB9AC\uD558\uBA74 \uC601\uAD6C\uC801\uC73C\uB85C \uCC28\uAC10\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5392725658435584
    m_Localized: "\uD568\uB300\uB97C \uD0A4\uC6CC \uC801\uB4E4\uC758 \uCD94\uACA9\uC5D0
      \uB300\uC751\uD558\uAE30 \uC704\uD574\uC11C\uB294 \uD0D0\uC0AC\uB97C \uD1B5\uD574
      \uC790\uC6D0\uC744 \uC5BB\uACE0 \uD568\uB300\uB97C \uAC15\uD654\uD574\uC57C
      \uD569\uB2C8\uB2E4. \uD0D0\uC0AC \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5392725700378625
    m_Localized: "\uADF8\uB9AC\uB4DC\uC5D0\uC11C \uC778\uC811\uD55C \uC9C0\uC5ED(\uC140)\uC73C\uB85C
      \uD568\uB300\uB97C \uC774\uB3D9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5392725700378626
    m_Localized: "\uC774\uB3D9 \uBA85\uB839\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26288532360134656
    m_Localized: "\uD568\uB300 \uAD00\uB9AC\uCC3D\uC744 \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26434500229464064
    m_Localized: "\uD568\uC120 \uBC30\uCE58 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26469773436911616
    m_Localized: "\uD568\uC120\uC774 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uD574\uB2F9 \uD568\uC120\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26469773495631872
    m_Localized: "\uD568\uC120 \uC218\uC815 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBAA8\uB4C8\uC744
      \uD3B8\uC9D1\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26469773495631873
    m_Localized: "\uBE54 \uBAA8\uB4C8\uC744 \uC124\uCE58\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26469773495631874
    m_Localized: "\uBCC0\uACBD \uC0AC\uD56D\uC744 \uC801\uC6A9\uD558\uB824\uBA74
      \uD655\uC778\uC744 \uB204\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26653119160909825
    m_Localized: "\uC804\uD22C \uC2DC\uC791 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC801
      \uD568\uB300\uC640 \uAD50\uC804\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26653119160909826
    m_Localized: "\uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD588\uC2B5\uB2C8\uB2E4!
      \uD68D\uB4DD\uD55C \uC790\uC6D0\uC774 \uC801\uB9BD \uD3EC\uC778\uD2B8\uC5D0
      \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 26653119160909827
    m_Localized: "\uACC4\uC18D \uC774\uB3D9\uD558\uBA70 \uC774 \uC874\uC744 \uD0C8\uCD9C\uD560
      \uC218 \uC788\uB294 \uC9C0\uC5ED\uC744 \uCC3E\uC544\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26655375268642816
    m_Localized: "\uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uAC00 \uC5EC\uAE30 \uD45C\uC2DC\uB429\uB2C8\uB2E4
      \u2014 \uC704\uCABD\uC740 \uD655\uC815\uB41C \uBCF4\uC720\uB7C9, \uC544\uB798\uCABD\uC740
      \uC774\uBC88 \uB7F0\uC5D0\uC11C \uC801\uB9BD \uC911\uC778(\uC544\uC9C1 \uBBF8\uD655\uC815)
      \uC218\uB7C9\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950338236416
    m_Localized: "\uD568\uB300\uB97C \uD655\uC778\uD574\uBD05\uC2DC\uB2E4. \uD568\uB300
      \uAD00\uB9AC \uD654\uBA74\uC744 \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762368
    m_Localized: "\uC9C0\uD718\uB825\uC774 \uB298\uC5B4\uB098\uBA74 \uB354 \uB9CE\uAC70\uB098
      \uAC15\uD55C \uD568\uC120\uC744 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC5EC\uAE30\uB97C \uB20C\uB7EC \uC9C0\uD718\uB825\uC744 \uB298\uB824\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762369
    m_Localized: "\uC804\uCCB4 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBCF4\uC720\uD55C
      \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uB97C \uBAA8\uB450 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762370
    m_Localized: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uB97C
      \uC9C0\uD718\uB825\uC73C\uB85C \uC804\uD658\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 26917950392762371
    m_Localized: "\uC9C0\uD718\uB825\uC774 \uC99D\uAC00\uD588\uC2B5\uB2C8\uB2E4!
      \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uAC00 \uB0A8\uC744 \uB54C\uB9C8\uB2E4 \uC5B8\uC81C\uB4E0
      \uB2E4\uC2DC \uCC3E\uC544\uC640 \uC804\uD658\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527176814592
    m_Localized: "\uC5C5\uC801 \uD3EC\uC778\uD2B8\uB97C \uBAA8\uC544 \uC0C8\uB85C\uC6B4
      \uD568\uCCB4\uB97C \uC5B8\uB77D\uD560 \uC218 \uC788\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4!
      \uD568\uB300 \uAD00\uB9AC \uD654\uBA74\uC744 \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340544
    m_Localized: "\uC5EC\uAE30\uB97C \uB20C\uB7EC \uD568\uCCB4 \uC120\uD0DD \uBAA9\uB85D\uC744
      \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340545
    m_Localized: "\uC7A0\uAE34 \uD568\uCCB4\uB294 \uC5C5\uC801 \uD3EC\uC778\uD2B8\uB85C
      \uC5B8\uB77D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC7A0\uAE34 \uD568\uCCB4\uC758
      \uC5B8\uB77D \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC0AC\uC6A9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340546
    m_Localized: "\uC9C0\uD718\uAD00 \uB808\uBCA8\uC774 \uC62C\uB77C \uD568\uC120\uC744
      \uD55C \uCC99 \uB354 \uBC30\uCE58\uD560 \uC218 \uC788\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4!
      \uD568\uB300 \uAD00\uB9AC \uD654\uBA74\uC744 \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340547
    m_Localized: "\uC0C8\uB85C \uC5F4\uB9B0 \uBE48 \uC2AC\uB86F\uC744 \uB20C\uB7EC
      \uD568\uC120\uC744 \uCD94\uAC00\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340548
    m_Localized: "\uBC30\uCE58\uD560 \uD568\uCCB4\uB97C \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340549
    m_Localized: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD568\uC120\uC744
      \uBC30\uCE58\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28403527231340550
    m_Localized: "\uD568\uC120\uC774 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4!
      \uC9C0\uD718\uAD00 \uB808\uBCA8\uC774 \uC624\uB97C\uC218\uB85D \uB354 \uB9CE\uC740
      \uD568\uC120\uC744 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28414612789395456
    m_Localized: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC5C5\uC801 \uD3EC\uC778\uD2B8\uB97C
      \uC0AC\uC6A9\uD574 \uD568\uCCB4\uB97C \uC5B8\uB77D\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 28430607918694400
    m_Localized: "\uC9C0\uD718\uB825\uC774 \uBD80\uC871\uD574 \uC774 \uD568\uC120\uC744
      \uBC30\uCE58\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uD0D0\uD5D8 \uD3EC\uC778\uD2B8\uB97C
      \uC9C0\uD718\uB825\uC73C\uB85C \uC804\uD658\uD574 \uC9C0\uD718\uB825\uC744
      \uD655\uBCF4\uD55C \uB4A4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
