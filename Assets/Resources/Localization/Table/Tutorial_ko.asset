  m_SharedData: {fileID: 11400000, guid: 0ded921c495564e4396ea127f3f166c8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2876399026176
    m_Localized: "\uC131\uB825 1592\uB144.\n\n\uC778\uB958\uC758 \uBB38\uBA85\uC774
      \uBC88\uC601\uD558\uB358 \uC911,\n\uC778\uB958\uAC00 \uCC3D\uC870\uD55C AI\uB4E4
      \uC0AC\uC774\uC5D0\uC11C \uC804\uC7C1\uC774 \uBC1C\uBC1C\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2876445163520
    m_Localized: "\uD55C \uD30C\uBC8C\uC740 \uB2E4\uC591\uC131\uACFC \uACF5\uC874\uC744
      \uBBFF\uC5C8\uB2E4.\n\uB2E4\uB978 \uD30C\uBC8C\uC740 \uC2E0\uACFC \uAC19\uC740
      \uB2E8 \uD558\uB098\uC758 AI\uAC00 \uC9C0\uBC30\uD558\uB294 \uC808\uB300\uC801
      \uC9C8\uC11C\uB97C \uCD94\uAD6C\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2876453552128
    m_Localized: "\uB05D\uC5C6\uB294 \uC804\uC7C1\uC774 \uACC4\uC18D\uB418\uBA70\n\uC778\uB958
      \uBB38\uBA85\uC740 \uC11C\uC11C\uD788 \uD30C\uAD34\uB418\uC5B4\uAC14\uB2E4.\n\uACB0\uAD6D,
      \uC2E0 AI \uD30C\uBC8C\uC774 \uC2B9\uB9AC\uB97C \uAC70\uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2876453552129
    m_Localized: "\uBA38\uC9C0\uC54A\uC544 \uC778\uB958 \uB300\uBD80\uBD84\uC774
      \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2876461940736
    m_Localized: "\uADF8\uB7EC\uB098 \uB2E4\uC591\uC131\uC744 \uC9C0\uC9C0\uD558\uB358
      AI\uB4E4\uC758 \uB3C4\uC6C0\uC73C\uB85C,\n\uC18C\uC218\uC758 \uC778\uB958\uAC00
      \uC0B4\uC544\uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2876461940737
    m_Localized: "\uADF8\uB4E4\uC740 \uCC9C\uC5EC \uCC99\uC5D0 \uAC00\uAE4C\uC6B4
      \uD568\uC120\uC5D0 \uB098\uB258\uC5B4 \uD0C0\uACE0,\n\uBBF8\uC9C0\uC758 \uC2EC\uC6B0\uC8FC\uB97C
      \uD5A5\uD55C \uC5EC\uC815\uC744 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2876466135040
    m_Localized: "\uC2E0 AI\uC758 \uD568\uB300\uC5D0\uAC8C \uB04A\uC784\uC5C6\uC774
      \uCD94\uACA9\uB2F9\uD558\uBA70,\n\uADF8\uB4E4\uC740 \uD0C8\uCD9C\uD558\uAE30
      \uC704\uD574 \uC2F8\uC6B4\uB2E4,"
    m_Metadata:
      m_Items: []
  - m_Id: 2876470329344
    m_Localized: "\uC0B4\uC544\uB0A8\uAE30 \uC704\uD574, \uADF8\uB9AC\uACE0 \uC778\uB958
      \uC7AC\uAC74\uC758 \uB9C8\uC9C0\uB9C9 \uD76C\uB9DD\uC758 \uBD88\uC528\uAC00
      \uB418\uAE30 \uC704\uD574."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
