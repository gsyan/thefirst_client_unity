  m_SharedData: {fileID: 11400000, guid: 0ded921c495564e4396ea127f3f166c8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 267705026215936
    m_Localized: "\uC9C0\uD06C\uD504\uB9AC\uD2B8 \uD568\uB300\uB294 \uC9C0\uAE08
      \uC0C8\uB85C\uC6B4 \uD568\uC120\uC744 \uCD94\uAC00\uD574\uC57C \uD569\uB2C8\uB2E4.
      \uC81C \uC124\uBA85\uC5D0 \uB530\uB77C \uC9C4\uD589\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 263406917386240
    m_Localized: "\uC548\uB155\uD558\uC138\uC694, \uC9C0\uD718\uAD00\uB2D8. \uD6C8\uB828
      AI\uC785\uB2C8\uB2E4.\n\uC624\uB298\uB3C4 \uD568\uB300 \uC9C0\uD718\uAD00\uC774
      \uB418\uAE30 \uC704\uD55C \uD6C8\uB828\uC744 \uC774\uC5B4 \uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 267705026215937
    m_Localized: "\uD568\uB300 \uD0ED\uC744 \uC5F4\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 267705026215938
    m_Localized: "\uD568\uC120 \uCD94\uAC00 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1319437449691136
    m_Localized: "\uD568\uC120\uC744 \uCD94\uAC00\uD558\uB824\uBA74 \uC77C\uC815
      \uC218\uC900\uC758 \uC9C0\uD718 \uB808\uBCA8\uC774 \uD544\uC694\uD55C\uB370,
      \uC9C0\uAE08\uC740 \uCDA9\uBD84\uD558\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1319437483245568
    m_Localized: "\uD568\uC120\uC744 \uCD94\uAC00\uD560 \uB54C\uB294 \uBAA8\uB4C8
      \uD3EC\uC778\uD2B8\uAC00 \uC18C\uBAA8\uB429\uB2C8\uB2E4. \uBAA8\uB4C8 \uD3EC\uC778\uD2B8\uB294
      \uC5B8\uC81C\uB4E0 \uD68C\uC218\uD560 \uC218 \uC788\uC73C\uB2C8 \uAC71\uC815
      \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1319437483245569
    m_Localized: "\uD568\uC120 \uCD94\uAC00\uB97C \uACB0\uC815 \uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1328699047542784
    m_Localized: "\uC801\uB4E4\uC758 \uC190\uAE38\uC774 \uB2FF\uC9C0 \uC54A\uC744
      \uB9CC\uD07C \uBA40\uACE0 \uBA3C \uC6B0\uC8FC\uC758 \uB05D\uC5D0 \uB3C4\uB2EC\uD560
      \uC218 \uC788\uB3C4\uB85D \uC774 \uD568\uC120, \uD568\uB300\uB97C \uC798 \uC774\uB04C\uC5B4
      \uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1336507092566016
    m_Localized: "\uD568\uC120\uC774 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444003811328
    m_Localized: "\uD568\uC120\uC774 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uD568\uC120\uC744 \uD130\uCE58\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444041560064
    m_Localized: "\uD568\uC120 \uAD00\uB9AC \uBC84\uD2BC\uC744 \uD130\uCE58\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444049948672
    m_Localized: "\uBE54 \uBAA8\uB4C8\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444054142976
    m_Localized: "\uBE54 \uBAA8\uB4C8\uC744 \uAC15\uD654\uD558\uC138\uC694. \uBAA8\uB4C8
      \uD3EC\uC778\uD2B8\uAC00 \uC544\uC9C1 \uCDA9\uBD84\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444058337280
    m_Localized: "\uBBF8\uC0AC\uC77C \uBAA8\uB4C8\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444062531584
    m_Localized: "\uBBF8\uC0AC\uC77C \uBAA8\uB4C8\uC744 \uC7A0\uAE08 \uD574\uC81C\uD558\uC138\uC694.
      \uBAA8\uB4C8 \uD3EC\uC778\uD2B8\uAC00 \uC544\uC9C1 \uCDA9\uBD84\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444066725888
    m_Localized: "\uBBF8\uC0AC\uC77C \uBAA8\uB4C8\uC744 \uAC15\uD654\uD558\uC138\uC694.
      \uBAA8\uB4C8 \uD3EC\uC778\uD2B8\uAC00 \uC544\uC9C1 \uCDA9\uBD84\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444075114496
    m_Localized: "\uACA9\uB0A9\uACE0 \uBAA8\uB4C8\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444079308800
    m_Localized: "\uACA9\uB0A9\uACE0 \uBAA8\uB4C8\uC744 \uC7A0\uAE08 \uD574\uC81C\uD558\uC138\uC694.
      \uBAA8\uB4C8 \uD3EC\uC778\uD2B8\uAC00 \uC544\uC9C1 \uCDA9\uBD84\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444083503104
    m_Localized: "\uACA9\uB0A9\uACE0 \uBAA8\uB4C8\uC744 \uAC15\uD654\uD558\uC138\uC694.
      \uBAA8\uB4C8 \uD3EC\uC778\uD2B8\uAC00 \uC544\uC9C1 \uCDA9\uBD84\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444087697408
    m_Localized: "\uD568\uCCB4 \uBAA8\uB4C8\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444091891712
    m_Localized: "\uD568\uCCB4 \uBAA8\uB4C8\uC744 \uAC15\uD654\uD558\uC138\uC694.
      \uBAA8\uB4C8 \uD3EC\uC778\uD2B8\uAC00 \uC544\uC9C1 \uCDA9\uBD84\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1368444096086016
    m_Localized: "\uD568\uCCB4 \uBAA8\uB4C8\uC744 \uAC15\uD654\uD558\uBA74 \uD568\uC120\uC758
      \uCCB4\uB825\uBFD0 \uC544\uB2C8\uB77C \uACF5\uACA9 \uBAA8\uB4C8\uC758 \uAC1C\uC218\uB3C4
      \uB298\uC5B4\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380098930245632
    m_Localized: "\uD568\uC120 \uAD00\uB9AC \uD6C8\uB828 \uACFC\uC815\uC740 \uC774\uB9CC
      \uB9C8\uCE58\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380098980577280
    m_Localized: "\uAE34\uAE09 \uC0C1\uD669, \uC801 \uD568\uB300 \uB2E4\uC218 \uC811\uADFC
      \uC911!!"
    m_Metadata:
      m_Items: []
  - m_Id: 1380098984771584
    m_Localized: "\uC801 \uD568\uB300\uAC00 \uC6CC\uD504\uC778\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380098988965888
    m_Localized: "\uD568\uB300 \uAC04 \uC804\uD22C\uB97C \uACBD\uD5D8\uD574 \uBCF4\uB294
      \uAC74 \uC6B4\uC774 \uC88B\uC740 \uAC78\uAE4C\uC694, \uB098\uC05C \uAC78\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1380098993160192
    m_Localized: "\uC5C4\uCCAD\uB09C \uADDC\uBAA8\uC758 \uC801 \uD568\uB300\uAC00
      \uC6CC\uD504\uC778\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380098997354496
    m_Localized: "\uC804\uD669\uC774 \uB9E4\uC6B0 \uBD88\uB9AC\uD569\uB2C8\uB2E4.
      \uD544\uC218 \uC804\uD22C \uC9C0\uD718\uAD00\uC744 \uC81C\uC678\uD55C \uBAA8\uB4E0
      \uC790\uC6D0\uC740 \uC9C0\uAE08 \uC989\uC2DC \uD0C8\uCD9C \uD568\uC120\uC5D0
      \uD0D1\uC2B9 \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380099001548800
    m_Localized: "\uC9C0\uAE08 \uC989\uC2DC \uD0C8\uCD9C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1380099005743104
    m_Localized: "\uB2F9\uC2E0\uC740 \uC774\uC81C \uC774 \uD568\uC120\uC758 \uC9C0\uD718\uAD00\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1726800145022976
    m_Localized: "\uC774\uC81C\uBD80\uD130\uB294 \uBAA8\uB4C8 \uD3EC\uC778\uD2B8\uB9CC\uC73C\uB85C\uB294
      \uC55E\uC73C\uB85C \uB9CC\uB0A0 \uC801\uB4E4\uC744 \uC774\uACA8\uB0B4\uAE30
      \uC5B4\uB824\uC6B8 \uAC83\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1726800233103360
    m_Localized: "\uC774\uC81C \uBBF8\uB124\uB784\uB85C\uB3C4 \uBAA8\uB4C8\uC744
      \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBBF8\uB124\uB784 \uAC15\uD654
      \uBAA8\uB4DC\uB85C \uBCC0\uACBD\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1726800233103361
    m_Localized: "\uBBF8\uB124\uB784 \uAC15\uD654\uC5D0 \uC0AC\uC6A9\uD55C \uBBF8\uB124\uB784\uC758
      \uCD1D\uB7C9\uC740 \uBCF4\uC720 \uBBF8\uB124\uB784 \uC606\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1726800233103362
    m_Localized: "\uBBF8\uB124\uB784 \uAC15\uD654\uC5D0 \uC0AC\uC6A9\uD55C \uBBF8\uB124\uB784\uC740
      \uC5B8\uC81C\uB4E0 \uD68C\uC218\uD560 \uC218 \uC788\uC9C0\uB9CC, \uC804\uD22C\uC5D0\uC11C
      \uC2B9\uB9AC\uD558\uBA74 \uC601\uAD6C\uC801\uC73C\uB85C \uCC28\uAC10\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5376173907247104
    m_Localized: "\uBE54 \uBAA8\uB4C8\uC774 \uB808\uBCA8 2\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5376173940801536
    m_Localized: "\uBBF8\uC0AC\uC77C \uBAA8\uB4C8\uC774 \uB808\uBCA8 2\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5376173940801537
    m_Localized: "\uACA9\uB0A9\uACE0 \uBAA8\uB4C8\uC774 \uB808\uBCA8 2\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5376173940801538
    m_Localized: "\uD568\uCCB4 \uBAA8\uB4C8\uC774 T2 \uB4F1\uAE09\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5392725658435584
    m_Localized: "\uD568\uB300\uB97C \uD0A4\uC6CC \uC801\uB4E4\uC758 \uCD94\uACA9\uC5D0
      \uB300\uC751\uD558\uAE30 \uC704\uD574\uC11C\uB294 \uD0D0\uC0AC\uB97C \uD1B5\uD574
      \uC790\uC6D0\uC744 \uC5BB\uACE0 \uD568\uB300\uB97C \uAC15\uD654\uD574\uC57C
      \uD569\uB2C8\uB2E4. \uD0D0\uC0AC \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5392725700378624
    m_Localized: "\uC774 \uC2A4\uD14C\uC774\uC9C0\uB97C \uD074\uB9AC\uC5B4\uD558\uBA74
      \uC5BB\uC744 \uC218 \uC788\uB294 \uC790\uC6D0\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5392725700378625
    m_Localized: "\uC2A4\uD14C\uC774\uC9C0\uC5D0 \uC785\uC7A5\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5392725700378626
    m_Localized: "\uC785\uC7A5\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  references:
