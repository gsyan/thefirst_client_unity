# Google Play 내부 테스트 트랙 배포
default_platform(:android)

platform :android do
  desc "[임시 디버그] Google Play 실제 트랙 ID 목록 출력"
  lane :list_tracks do
    require 'supply'
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options,
      {
        package_name: "com.fidforge.thefirst",
        json_key: ENV["GOOGLE_PLAY_JSON_KEY"],
      }
    )
    client = Supply::Client.make_from_config
    client.tracks("com.fidforge.thefirst").each do |t|
      UI.message("track id = #{t.track}")
    end
  end

  desc "내부 테스트 트랙에 AAB 업로드"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY"],
      aab: ENV["APK_PATH"],
      version_name: ENV["VERSION_NAME"],
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "내부 테스트 트랙 빌드를 비공개 테스트(검수 요청) 트랙으로 승격"
  lane :closed_testing do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "4699219595168378744",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY"],
      version_name: ENV["VERSION_NAME"],
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_aab: true,
      skip_upload_apk: true,
    )
  end
end
